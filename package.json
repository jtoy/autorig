{
  "name": "distark-render",
  "version": "1.0.6",
  "description": "Rendering-agnostic character rig system with TypeScript",
  "type": "module",
  "main": "./dist/modules/renderRig.js",
  "types": "./dist/modules/renderRig.d.ts",
  "exports": {
    ".": {
      "types": "./dist/modules/renderRig.d.ts",
      "import": "./dist/modules/renderRig.js"
    },
    "./imageLoad": {
      "types": "./dist/modules/imageLoad.d.ts",
      "import": "./dist/modules/imageLoad.js"
    },
    "./eyeSystem": {
      "types": "./dist/modules/eyeSystem.d.ts",
      "import": "./dist/modules/eyeSystem.js"
    },
    "./mouthSystem": {
      "types": "./dist/modules/mouthSystem.d.ts",
      "import": "./dist/modules/mouthSystem.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    },
    "./p5": {
      "types": "./dist/modules/adapters/p5Renderer.d.ts",
      "import": "./dist/modules/adapters/p5Renderer.js"
    },
    "./skia": {
      "types": "./dist/modules/adapters/skiaRenderer.d.ts",
      "import": "./dist/modules/adapters/skiaRenderer.js"
    },
    "./animationDiff": {
      "types": "./dist/modules/animationDiff.d.ts",
      "import": "./dist/modules/animationDiff.js"
    }
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "dev": "tsc --watch & http-server -p 8080",
    "clean": "rm -rf dist",
    "serve": "http-server -p 8080",
    "test": "npm run build && node dist/tests/test-animation-diff.js && node dist/tests/test-animation-diff-rendering.js && node dist/tests/test-visual-verification.js && node dist/tests/test-joint-movement.js",
    "test-skia": "npm run build && node dist/tests/test-skia.js",
    "test-visual": "npm run build && node dist/tests/test-visual-verification.js",
    "test-joints": "npm run build && node dist/tests/test-joint-movement.js",
    "test-diff": "npm run build && node dist/tests/test-animation-diff.js",
    "test-diff-render": "npm run build && node dist/tests/test-animation-diff-rendering.js",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "keywords": [
    "character",
    "rig",
    "animation",
    "canvas",
    "rendering",
    "2d"
  ],
  "author": "liaokira",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^25.2.0",
    "typescript": "^5.3.3"
  },
  "optionalDependencies": {
    "skia-canvas": "^3.0.8"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jtoy/distark_render.git"
  },
  "bugs": {
    "url": "https://github.com/jtoy/distark_render/issues"
  },
  "homepage": "https://github.com/jtoy/distark_render#readme"
}
